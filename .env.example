# Database (required). Never commit the real value — this is a template only.
DATABASE_URL=postgresql://user:password@host:5432/database

# Public canonical site URL used for canonical/OG tags, sitemap and JSON-LD.
# IMPORTANT for SEO: set this to the final production/custom domain (https://...).
# If omitted on Vercel, the code falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://mdacars-site.vercel.app

# No authentication secret is required. Admin passwords are hashed with
# bcrypt (never stored in plain text), and admin sessions use a random,
# server-generated token stored (hashed) in the database — there is no
# shared signing secret to configure or leak.

# Vercel Blob image storage (automatically added when a Blob store is connected in Vercel).
# BLOB_READ_WRITE_TOKEN=
